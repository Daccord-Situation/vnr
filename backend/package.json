{
  "name": "vnr-backend",
  "version": "0.1.0",
  "description": "Backend VNR — plateforme SaaS de gestion d'entreprise (Daccord Situation)",
  "author": "Taphsir Abdoulaye",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand --forceExit",
    "test:cov": "jest --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "dotenv": "16.4.7",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.9",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "6.1.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.test\\.ts$",
    "moduleFileExtensions": ["ts", "js", "json"]
  }
}
