# --- Dépendances ---
node_modules/

# --- Build ---
dist/

# --- Variables d'environnement et secrets ---
.env
.env.local
.env.*.local
# .env.example reste versionné (modèle sans secret)

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Tests et couverture ---
coverage/

