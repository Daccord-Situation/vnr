// =============================================================================
//  VNR — Schéma de base de données
//  Incrément I1 : socle SaaS sécurisé
//  Développeur : Taphsir Abdoulaye
// -----------------------------------------------------------------------------
//  Fondation multi-tenant : chaque entreprise cliente est un tenant isolé.
//  Invariant I01 (Phase A6) : isolation tenant absolue.
//
//  Ce schéma représente la fondation initiale du Sprint 0.
//  Il sera enrichi au fil des incréments selon la Phase B.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
//  Fondation multi-tenant
// ---------------------------------------------------------------------------

/// Entreprise cliente = tenant. Frontière d'isolation absolue des données.
/// Créé et activé par le Platform Side ; configuré par le Business Side.
model Tenant {
  id        String       @id @default(cuid())
  name      String
  status    TenantStatus @default(TRIAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users     User[]

  @@map("tenants")
}

/// Cycle de vie d'une entreprise (Cadrage Platform Side §10).
enum TenantStatus {
  TRIAL
  ACTIVE
  EXPIRING_SOON
  GRACE_PERIOD
  SUSPENDED
  TERMINATED
  ARCHIVED
}

// ---------------------------------------------------------------------------
//  Utilisateurs
// ---------------------------------------------------------------------------

/// Utilisateur du système.
/// - PLATFORM : utilisateur Daccord Situation (tenantId null).
/// - BUSINESS  : utilisateur d'une entreprise cliente (tenantId requis).
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  fullName  String
  domain    UserDomain
  status    UserStatus @default(ACTIVE)
  tenantId  String?
  tenant    Tenant?    @relation(fields: [tenantId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tenantId])
  @@map("users")
}

/// Namespaces stricts platform.* / business.* — aucune collision (A6).
enum UserDomain {
  PLATFORM
  BUSINESS
}

enum UserStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}
