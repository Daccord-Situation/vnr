# =============================================================
#  VNR Backend — Variables d'environnement (exemple)
#  Sprint 0 — Incrément I1 : socle SaaS sécurisé
#  Développeur : Taphsir Abdoulaye
# -----------------------------------------------------------------
#  Copier ce fichier en .env puis adapter les valeurs.
#  NE JAMAIS committer .env — aucun secret dans Git (règle Sprint 0).
# =============================================================

# --- Application ---
# Environnement d'exécution : development | production | test
NODE_ENV=development

# Port d'écoute du serveur backend
PORT=3000

# --- Base de données (PostgreSQL) ---
# URL de connexion Prisma. Format :
# postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE?schema=public
#
# En développement local, adaptez selon votre instance PostgreSQL.
# La configuration de la base de données est une PROPOSITION à valider
# par VNR – Responsable (règle du mandat Sprint 0).
DATABASE_URL=postgresql://vnr_user:vnr_password@localhost:5432/vnr_dev?schema=public

# --- Sécurité (à activer dès l'implémentation de l'authentification) ---
# Clé secrète pour signer les jetons JWT — générer une clé forte en production.
# Ne jamais la versionner. La laisser commentée tant que l'auth n'est pas implémentée.
# JWT_SECRET=

# Durée de validité d'un jeton d'accès (ex: 15m, 1h, 7d)
# JWT_EXPIRES_IN=15m
